{
    "phase_type": "gs",
    "log": {
        "log_file": "gs.log",
        "log_formatter": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
    },
    "seed": 42,
    "data": {
        "data_dir": "data",
        "resolution_scale": 2,
        "max_initial_gaussians": 20000
    },
    "training": {
        "iterations": 300,
        "learning_rate": 1.6e-4,
        "learning_rates": {
            "means":     1.6e-4,
            "sh_coeffs": 2.5e-3,
            "opacities": 5e-2,
            "scales":    5e-3,
            "rotations": 1e-3
        },
        "optimizer": "adam",
        "adam_betas": [0.9, 0.999],
        "adam_eps": 1e-15,
        "adam_weight_decay": 0,
        "lambda_ssim": 0.2,
        "scheduler": {
            "use": false,
            "type": "StepLR",
            "step_size": 1000,
            "gamma": 0.1,
            "mode": "min",
            "factor": 0.1,
            "patience": 200,
            "min_lr": 1e-6
        },
        "adc": {
            "start_iteration": 100,
            "interval": 100,
            "stop_iteration": 250,
            "opacity_reset_interval": 999999,
            "grad_threshold": 0.0002,
            "scale_threshold": 0.01,
            "opacity_threshold": 0.005,
            "max_gaussians": 100000
        }
    },
    "device": "auto"
}
